{
  "name": "@galaxia/api-server",
  "version": "1.0.0",
  "description": "Galaxia AI Network API Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:load": "node tests/load-test.js",
    "test:competitive": "jest tests/competitive.test.ts",
    "demo": "bash scripts/demo.sh",
    "verify": "bash scripts/verify-deployment.sh",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "psql -U postgres -d galaxia -f database/schema.sql",
    "db:migrate:tenant": "psql -U postgres -d galaxia -f database/migrations/add_tenant_security.sql",
    "db:migrate:hardening": "psql -U postgres -d galaxia -f database/migrations/add_production_hardening.sql"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.4.1",
    "axios": "^1.19.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "redis": "^4.7.1",
    "snarkjs": "^0.7.5",
    "supertest": "^6.3.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
