# Galaxia AIN api-server — SMB Pilot environment

# Database (Render/Railway provides DATABASE_URL)
DATABASE_URL=
DB_SSL=true
# TENANT_MIGRATION_APPLIED set by entrypoint after migrations succeed — do not pre-set true

# Auth
JWT_SECRET=
JWT_ISSUER=galaxia-ain
JWT_AUDIENCE=galaxia-ain
ALLOW_DEV_AUTH=false
ALLOW_MAINNET=false
FREE_TIER_SIGNUP_ENABLED=true

# CORS — Vercel frontend
ALLOWED_ORIGINS=https://galaxia-ai-testnet.vercel.app

# OpenAI (required for real inference path)
OPENAI_API_KEY=

# Upstash (required for production rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DISTRIBUTED_RATE_LIMIT=true

# Observability (optional)
SENTRY_DSN=

# Pilot bootstrap (non-production only)
INTERNAL_BOOTSTRAP_KEY=

# Inference
DOCKER_INFERENCE_ENABLED=false

# NOTE: TENANT_MIGRATION_APPLIED is set by docker-entrypoint.sh after schema verify.
# Do not set it true manually unless migrations have actually succeeded.
